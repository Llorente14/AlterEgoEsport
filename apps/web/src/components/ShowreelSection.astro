---
import SectionLabel from './SectionLabel.astro';
---

<section id="showreel" class="px-[var(--gutter)] py-48" aria-labelledby="showreel-title">
  <div class="relative mx-auto aspect-[4/5] max-w-[1600px] overflow-hidden rounded-card bg-ink md:aspect-video">
    <!-- Sources are attached by the script when the frame nears the viewport (lazy load). -->
    <video
      class="absolute inset-0 size-full object-cover"
      muted
      loop
      playsinline
      preload="none"
      poster="/video/showreel-poster.webp"
      aria-label="Showreel highlight pertandingan Alter Ego"
      data-showreel
      data-src-mobile="/video/showreel-480.mp4"
      data-src-webm="/video/showreel-720.webm"
      data-src-mp4="/video/showreel-720.mp4"
    ></video>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-16 bg-linear-to-t from-void/80 to-transparent p-24 pt-96 md:p-48">
      <SectionLabel number="02" label="Showreel" class="text-silver" />
      <h2 id="showreel-title" class="font-display text-heading uppercase leading-heading">Musim ini, di arena</h2>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-showreel]');
  if (video) {
    const attach = () => {
      const { srcMobile, srcWebm, srcMp4 } = video.dataset;
      const sources = window.matchMedia('(max-width: 767px)').matches
        ? [[srcMobile, 'video/mp4']]
        : [[srcWebm, 'video/webm'], [srcMp4, 'video/mp4']];
      for (const [src, type] of sources) {
        const source = document.createElement('source');
        source.src = src!;
        source.type = type!;
        video.append(source);
      }
      video.load();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) video.play().catch(() => {});
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          attach();
        }
      },
      { rootMargin: '0px' },
    );
    observer.observe(video);
  }
</script>
