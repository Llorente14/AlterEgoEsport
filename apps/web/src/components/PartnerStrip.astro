---
import { getPartners, type Partner } from '../lib/catalog';
import SectionLabel from './SectionLabel.astro';

const partners = getPartners();
---

<!-- Each partner is a monochrome logo, or its name as a wordmark until a logo file is added. -->
<section id="partners" class="flex flex-col gap-48 py-96" aria-labelledby="partners-title">
  <div class="container-page flex flex-col gap-16">
    <SectionLabel number="08" label="Partners" />
    <h2 id="partners-title" class="font-display text-heading uppercase leading-heading">Didukung oleh</h2>
  </div>

  <!-- Desktop: slow right-to-left marquee. Two copies in the HTML; the script adds more until the screen is full. -->
  <div class="partner-marquee hidden overflow-hidden lg:block" data-partner-marquee>
    <div class="partner-track flex w-max">
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center gap-64 pr-64" data-partner-set aria-hidden={copy === 1 ? 'true' : undefined}>
            {partners.map((p: Partner) => (
              <li class="flex h-64 items-center">
                {p.logoSrc ? (
                  <img src={p.logoSrc} alt={copy === 0 ? p.name : ''} width={p.width} height={p.height} class="partner-logo h-40 w-auto" style={p.scale === 1 ? undefined : `height:${40 * p.scale}px`} loading="lazy" />
                ) : (
                  <span class="partner-wordmark font-display text-[28px] leading-none">{p.name}</span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <!-- Mobile and tablet: static grid. -->
  <ul class="container-page grid grid-cols-2 gap-x-24 gap-y-32 sm:grid-cols-3 lg:hidden" aria-label="Partner">
    {
      partners.map((p) => (
        <li class="flex h-48 items-center justify-center">
          {p.logoSrc ? (
            <img src={p.logoSrc} alt={p.name} width={p.width} height={p.height} class="partner-logo h-32 w-auto max-w-full" style={p.scale === 1 ? undefined : `height:${32 * p.scale}px`} loading="lazy" />
          ) : (
            <span class="partner-wordmark text-center font-display text-[22px] leading-none">{p.name}</span>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Partners appear in one tone: logos are flattened to white, wordmarks match them. */
  .partner-logo {
    filter: brightness(0) invert(1);
    opacity: 0.7;
    transition: opacity var(--duration-fast) var(--ease-out);
  }
  .partner-wordmark {
    color: color-mix(in srgb, var(--color-bone) 70%, transparent);
    transition: color var(--duration-fast) var(--ease-out);
  }
  li:hover > .partner-logo {
    opacity: 1;
  }
  li:hover > .partner-wordmark {
    color: var(--color-bone);
  }

  .partner-track {
    animation: partner-scroll var(--marquee-duration, 40s) linear infinite;
  }
  .partner-marquee:hover .partner-track {
    animation-play-state: paused;
  }
  @keyframes partner-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--marquee-shift, -50%));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .partner-track {
      animation: none;
    }
  }
</style>

<script>
  // One set of partners is narrower than a wide screen, so two copies leave a gap before the loop restarts.
  // Clone sets until the track covers the screen plus one set, then shift by exactly one set (in px).
  const SPEED = 28; // px per second (the old 40s loop over one set)
  const marquee = document.querySelector<HTMLElement>('[data-partner-marquee]');
  const track = marquee?.querySelector<HTMLElement>('.partner-track');
  const first = track?.querySelector<HTMLElement>('[data-partner-set]');

  if (marquee && track && first) {
    const fill = () => {
      const setWidth = first.getBoundingClientRect().width;
      if (setWidth === 0) return; // hidden (below lg)
      const needed = Math.ceil(marquee.clientWidth / setWidth) + 1;
      let sets = track.querySelectorAll('[data-partner-set]').length;
      for (; sets < needed; sets++) {
        const copy = first.cloneNode(true) as HTMLElement;
        copy.setAttribute('aria-hidden', 'true');
        for (const img of copy.querySelectorAll('img')) {
          img.alt = '';
          img.loading = 'eager';
        }
        track.append(copy);
      }
      track.style.setProperty('--marquee-shift', `${-setWidth}px`);
      track.style.setProperty('--marquee-duration', `${(setWidth / SPEED).toFixed(1)}s`);
    };
    new ResizeObserver(fill).observe(first);
    new ResizeObserver(fill).observe(marquee);
    fill();
  }
</script>
