---
// Page-wide ambient layer: faint triangles and petals drifting right to left behind all content.
import SakuraPetals from './SakuraPetals.astro';

const triangles = Array.from({ length: 40 }, (_, i) => ({
  top: `${(i * 61) % 100}%`,
  size: 3 + ((i * 3) % 4), // 3–6px
  duration: 30 + ((i * 11) % 31), // 30–60s: slower than the hero wind
  delay: -((i * 13) % 60),
  rotate: (i * 47) % 360,
  red: i % 4 === 0,
}));
---

<div class="ambient pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true" data-ambient>
  {
    triangles.map((t) => (
      <span
        class="ambient-tri absolute left-0"
        style={`top:${t.top};--s:${t.size}px;--r:${t.rotate}deg;animation-duration:${t.duration}s;animation-delay:${t.delay}s;color:var(${t.red ? '--color-signal-red' : '--color-bone'})`}
      />
    ))
  }
  <SakuraPetals count={10} />
</div>

<style>
  .ambient {
    opacity: 0.15;
  }
  .ambient-tri {
    width: 0;
    height: 0;
    border-left: calc(var(--s) / 2) solid transparent;
    border-right: calc(var(--s) / 2) solid transparent;
    border-bottom: var(--s) solid currentColor;
    will-change: transform;
    animation-name: ambient-drift;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes ambient-drift {
    from {
      transform: translate3d(calc(100vw + 20px), 0, 0) rotate(var(--r));
    }
    to {
      transform: translate3d(-20px, 3vh, 0) rotate(calc(var(--r) + 180deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient {
      display: none;
    }
  }
</style>
