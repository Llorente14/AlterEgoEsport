---
import SectionLabel from './SectionLabel.astro';
---

<section
  id="hero"
  class="relative overflow-hidden"
  aria-labelledby="hero-title"
  data-hero-state="static"
>
  <!-- WebGL layer (desktop only), faded on the left so the headline stays readable. -->
  <div class="hero-canvas pointer-events-none absolute inset-0" data-hero-canvas aria-hidden="true"></div>

  <div class="container-page relative grid min-h-[calc(100dvh-80px)] items-center gap-48 py-64 lg:grid-cols-12">
    <div class="flex flex-col gap-24 lg:col-span-7">
      <img
        src="/logo/alterego-logo-256.webp"
        alt=""
        width="96"
        height="93"
        class="w-96 lg:hidden"
        fetchpriority="high"
      />
      <SectionLabel number="01" label="Alter Ego Esports · Est. 2018" />
      <h1 id="hero-title" class="font-display text-display-xl uppercase leading-display tracking-display">
        Wear<br />Your<br /><span class="text-signal-red">Alter</span> Ego
      </h1>
      <p class="max-w-[440px] text-silver">
        Tim esports Indonesia di Mobile Legends, Counter-Strike 2, dan PUBG Mobile. Pakai jersey yang sama dengan
        mereka di Alter Merch.
      </p>
      <div class="flex flex-wrap items-center gap-24">
        <a
          href="/store"
          class="group inline-flex min-h-48 items-center gap-8 rounded-control bg-ego-red px-24 text-[14px] font-semibold uppercase tracking-ui text-bone transition-colors duration-200 hover:bg-ego-red-hover"
        >
          Shop Alter Merch
          <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-4">→</span>
        </a>
        <a href="#roster" class="text-[16px] text-ash underline-offset-4 transition-colors hover:text-bone hover:underline">
          Lihat Roster →
        </a>
      </div>
    </div>

    <!-- The 2D logo is the placeholder and fallback; the 3D logo takes its exact place once loaded. -->
    <div class="relative hidden aspect-square items-center justify-center lg:col-span-5 lg:flex">
      <img
        src="/logo/alterego-logo-512.webp"
        alt="Logo Alter Ego"
        width="512"
        height="496"
        class="hero-logo-2d w-4/5"
        fetchpriority="high"
        data-hero-anchor
      />
    </div>
  </div>
</section>

<style>
  .hero-canvas {
    mask-image: linear-gradient(to right, rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.3) 40%, #000 65%);
  }
  .hero-logo-2d {
    transition: opacity var(--duration-slow) var(--ease-out);
  }
  [data-hero-state='ready'] .hero-logo-2d {
    opacity: 0;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#hero');
  const layer = section?.querySelector<HTMLElement>('[data-hero-canvas]');
  const anchor = section?.querySelector<HTMLElement>('[data-hero-anchor]');

  const supportsWebGL = () => {
    try {
      const canvas = document.createElement('canvas');
      return Boolean(canvas.getContext('webgl2') ?? canvas.getContext('webgl'));
    } catch {
      return false;
    }
  };

  const desktop = window.matchMedia('(min-width: 1024px)').matches;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && layer && anchor && desktop && !reducedMotion && supportsWebGL()) {
    section.dataset.heroState = 'loading';
    // Dynamic import: three.js and the model are only fetched on this path.
    import('../lib/hero/scene')
      .then(({ mountHero }) => mountHero(layer, { modelUrl: '/models/alterego-logo.glb', anchor, section }))
      .then(() => {
        section.dataset.heroState = 'ready';
      })
      .catch((error: unknown) => {
        console.error('[hero] 3D tidak dapat dimuat, memakai logo 2D.', error);
        section.dataset.heroState = 'fallback';
        layer.replaceChildren();
      });
  }
</script>
