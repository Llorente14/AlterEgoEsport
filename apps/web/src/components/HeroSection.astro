---
import SectionLabel from './SectionLabel.astro';
---

<section id="hero" class="relative isolate overflow-hidden bg-void" aria-labelledby="hero-title">
  <!-- Background video at 30% so the headline stays readable; the poster shows until it plays. -->
  <video
    class="absolute inset-0 -z-10 size-full object-cover opacity-30"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/video/showreel-poster.webp"
    aria-hidden="true"
    tabindex="-1"
    data-hero-video
  >
    <source src="/video/showreel-480.mp4" type="video/mp4" media="(max-width: 767px)" />
    <source src="/video/showreel-720.webm" type="video/webm" />
    <source src="/video/showreel-720.mp4" type="video/mp4" />
  </video>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-r from-void/80 via-void/30 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-160 bg-linear-to-t from-void to-transparent"
    aria-hidden="true"
  >
  </div>

  <div class="container-page flex min-h-[calc(100dvh-80px)] flex-col justify-center gap-24 py-64">
    <img src="/logo/alterego-logo-256.webp" alt="" width="96" height="93" class="w-96 lg:hidden" fetchpriority="high" />
    <SectionLabel number="01" label="Alter Ego Esports · Est. 2018" class="text-silver" />
    <h1 id="hero-title" class="font-display text-display-xl uppercase leading-display tracking-display">
      Wear<br />Your<br /><span class="text-signal-red">Alter</span> Ego
    </h1>
    <p class="max-w-[440px] text-silver">
      Tim esports Indonesia di Mobile Legends, Counter-Strike 2, dan PUBG Mobile. Pakai jersey yang sama dengan
      mereka di Alter Merch.
    </p>
    <div class="flex flex-wrap items-center gap-24">
      <a
        href="/store"
        class="group inline-flex min-h-48 items-center gap-8 rounded-control bg-ego-red px-24 text-[14px] font-semibold uppercase tracking-ui text-bone transition-colors duration-200 hover:bg-ego-red-hover"
      >
        Shop Alter Merch
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-4">→</span>
      </a>
      <a href="#roster" class="text-[16px] text-silver underline-offset-4 transition-colors hover:text-bone hover:underline">
        Lihat Roster →
      </a>
    </div>
  </div>
</section>

<script>
  // Reduced motion: keep the still poster instead of a moving background.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }
</script>
