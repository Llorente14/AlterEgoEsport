---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { GAME_LABELS } from '@alterego/shared';
import { formatNewsDate, NEWS_CATEGORY_LABELS } from '../lib/news';

interface Props {
  article: CollectionEntry<'news'>;
  featured?: boolean;
  headingLevel?: 2 | 3;
}

const { article, featured = false, headingLevel = 3 } = Astro.props;
const { title, date, category, game, excerpt, cover, coverAlt, coverPosition } = article.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="group relative flex flex-col gap-16" data-news-card>
  <div class="relative aspect-video overflow-hidden rounded-card bg-ink">
    <Image
      src={cover}
      alt={coverAlt}
      widths={featured ? [640, 960, 1280] : [400, 640, 800]}
      sizes={featured ? '(min-width: 1024px) 800px, 100vw' : '(min-width: 1024px) 400px, 100vw'}
      loading={featured ? 'eager' : 'lazy'}
      fetchpriority={featured ? 'high' : 'auto'}
      class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      style={coverPosition ? `object-position: ${coverPosition}` : undefined}
    />
    <span
      class="absolute right-16 top-16 flex size-56 -rotate-[8deg] items-center justify-center rounded-pill border-2 border-signal-red bg-void/70 font-mono text-[10px] font-medium uppercase text-signal-red"
    >
      {NEWS_CATEGORY_LABELS[category]}
    </span>
  </div>
  <div class="flex flex-col gap-8">
    <p class="font-mono text-label uppercase tracking-label text-ash">
      <time datetime={date.toISOString().slice(0, 10)}>{formatNewsDate(date)}</time>
      {game && <> · <span class="text-signal-red">{GAME_LABELS[game]}</span></>}
    </p>
    <Heading
      class:list={[
        'font-display uppercase leading-heading',
        featured ? 'text-heading' : 'line-clamp-3 text-[28px]',
      ]}
    >
      <a href={`/news/${article.id}`} class="after:absolute after:inset-0 after:rounded-card">{title}</a>
    </Heading>
    <p class="line-clamp-2 text-[16px] text-silver">{excerpt}</p>
  </div>
</article>
