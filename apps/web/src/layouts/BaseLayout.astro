---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AmbientField from '../components/AmbientField.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alter Ego Esports',
  description = 'Situs resmi Alter Ego Esports dan Alter Merch.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/png" href="/logo/alterego-logo-64.png" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <AmbientField />
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const sections = document.querySelectorAll<HTMLElement>('main > section:not(:first-child, [data-no-reveal])');
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-revealed');
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      sections.forEach((section) => reveal.observe(section));
    </script>
  </body>
</html>
