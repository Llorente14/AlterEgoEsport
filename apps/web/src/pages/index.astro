---
import BaseLayout from '../layouts/BaseLayout.astro';
import RosterSection from '../components/RosterSection.astro';
---

<BaseLayout>
  <section class="container-page flex min-h-[70dvh] flex-col justify-center gap-24 py-96">
    <p class="font-mono text-label uppercase tracking-label text-ash">
      <span class="text-signal-red">00</span> / Alter Ego Esports · Est. 2018
    </p>
    <h1 class="font-display text-display-xl uppercase leading-display tracking-display">
      Wear<br />Your<br />Alter Ego
    </h1>
    <p class="max-w-[440px] text-silver">Situs resmi sedang dibangun.</p>
  </section>
  <RosterSection />
</BaseLayout>
